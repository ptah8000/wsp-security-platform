# =============================================================================
# WSP deploy environment — copy to deploy/.env and edit before first start:
#
#   cd deploy
#   cp env.example .env
#
# REQUIRED: WSP_DATA_KEY must be set to a strong 32-byte secret. It encrypts
# CA private keys at rest. Generate one with:
#
#   openssl rand -base64 32
#
# Do not commit .env. Losing this key means encrypted keys cannot be decrypted.
# =============================================================================

WSP_MODE=all
WSP_PROXY_ADDR=:8080
WSP_ADMIN_ADDR=:3000

# Compose service hostname "postgres".
WSP_DATABASE_URL=postgres://wsp:wsp@postgres:5432/wsp?sslmode=disable

# REQUIRED for MITM CA storage.
WSP_DATA_KEY=

WSP_CLAMD_ADDR=clamav:3310
# Global default when a rule enables scanning; rules may set fail_mode=fail_closed.
WSP_MALWARE_FAIL_CLOSED=false

# RBI
DOCKER_HOST=unix:///var/run/docker.sock
WSP_RBI_IMAGE=browserless/chrome:latest
WSP_MAX_RBI_SESSIONS=10
# Must match Compose network name (docker-compose.yml sets name: wsp_net).
WSP_RBI_NETWORK=wsp_net
# Optional: CDP via published ports on the host (usually not needed when network is set).
# WSP_RBI_CDP_HOST=host.docker.internal

# Client Setup page / PAC — published host proxy coordinates
WSP_PUBLIC_PROXY_HOST=127.0.0.1
WSP_PUBLIC_PROXY_PORT=18080

# Set true when the admin UI is served only over HTTPS.
WSP_SECURE_COOKIE=false

# Linux Docker socket group (Docker Desktop: leave 0).
# DOCKER_GID=999

WSP_LOG_LEVEL=info
WSP_SHUTDOWN_TIMEOUT_SEC=15
