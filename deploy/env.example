# Copy to deploy/.env (or compose project root) and adjust as needed.
# Generate a 32-byte data key, e.g.: openssl rand -base64 32

WSP_MODE=all
WSP_PROXY_ADDR=:8080
WSP_ADMIN_ADDR=:3000
WSP_DATABASE_URL=postgres://wsp:wsp@postgres:5432/wsp?sslmode=disable
WSP_DATA_KEY=
WSP_CLAMD_ADDR=clamav:3310
# When true, malware scan errors (clamd down) block traffic; default fail-open.
WSP_MALWARE_FAIL_CLOSED=false
DOCKER_HOST=unix:///var/run/docker.sock
WSP_RBI_IMAGE=browserless/chrome:latest
WSP_MAX_RBI_SESSIONS=10
WSP_LOG_LEVEL=info
WSP_SHUTDOWN_TIMEOUT_SEC=15
