# =============================================================================
# WSP deploy environment — copy to deploy/.env and edit before first start:
#
#   cd deploy
#   cp env.example .env
#
# REQUIRED: WSP_DATA_KEY must be set to a strong 32-byte secret. It encrypts
# CA private keys at rest. Generate one with:
#
#   openssl rand -base64 32
#
# Example:
#   WSP_DATA_KEY=xK8...paste-output-here...
#
# Do not commit .env. Losing this key means encrypted keys cannot be decrypted.
# =============================================================================

WSP_MODE=all
WSP_PROXY_ADDR=:8080
WSP_ADMIN_ADDR=:3000

# Compose service hostname "postgres" (override for external DB).
WSP_DATABASE_URL=postgres://wsp:wsp@postgres:5432/wsp?sslmode=disable

# REQUIRED in production / for MITM CA storage — leave empty only for dry runs
# without certificate features.
WSP_DATA_KEY=

# ClamAV clamd inside the Compose network.
WSP_CLAMD_ADDR=clamav:3310

# When true, malware scan errors (clamd down / timeout) block traffic.
# Default false = fail-open (availability over strictness); set true for stricter orgs.
WSP_MALWARE_FAIL_CLOSED=false

# RBI uses the host Docker engine via the mounted socket.
DOCKER_HOST=unix:///var/run/docker.sock
WSP_RBI_IMAGE=browserless/chrome:latest
WSP_MAX_RBI_SESSIONS=10

WSP_LOG_LEVEL=info
WSP_SHUTDOWN_TIMEOUT_SEC=15
